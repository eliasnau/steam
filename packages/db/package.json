		"drizzle-orm": "^0.45.2",
		"ws": "^8.18.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.8",
		"typescript": "catalog:"
	}
